{
  "pipeline_name": "house_price_growth_ingestion",
  "source_name": "house_price_growth",
  "source": {
    "format": "csv",
    "options": {
      "header": true,
      "inferSchema": false
    }
  },
  "targets": {
    "trusted_path": "data/trusted/house_price_growth",
    "rejected_path": "data/rejected/house_price_growth",
    "transformed_path": "data/transformed/house_price_growth_summary"
  },
  "load_strategy": {
    "type": "full_overwrite",
    "description": "Every delivery is a complete table snapshot. Replace the trusted baseline each run."
  },
  "schema": {
    "columns": [
      {"name": "state", "type": "string", "required": true},
      {"name": "county", "type": "string", "required": true},
      {"name": "report_year", "type": "integer", "required": true},
      {"name": "median_price", "type": "double", "required": true},
      {"name": "growth_pct", "type": "double", "required": true}
    ]
  },
  "dq_rules": {
    "primary_key": ["state", "county", "report_year"],
    "duplicate_check": true,
    "non_negative_columns": ["median_price"]
  },
  "trusted": {
    "interested_columns": [
      "state",
      "county",
      "report_year",
      "median_price",
      "growth_pct"
    ],
    "partition_by": ["report_year", "state"]
  },
  "transformation": {
    "enabled": false,
    "output_mode": "overwrite",
    "partition_by": [],
    "rules": []
  }
}
